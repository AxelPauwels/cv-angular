{
  "name": "@axel-pauwels/cv",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "project-graph": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/.project-graph"],
      "options": {
        "commands": [
          "nx graph --file=dist/.project-graph/index.html --open=false",
          "node tools/project-graph/strip-task-data.mjs"
        ],
        "parallel": false
      }
    },
    "compodoc": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tsconfig.compodoc.json",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/apps/cv/src/**/*",
        "{workspaceRoot}/libs/**/src/**/*"
      ],
      "outputs": ["{workspaceRoot}/dist/.compodoc"],
      "options": {
        "commands": [
          "node -e \"require('fs').rmSync('dist/.compodoc',{recursive:true,force:true})\"",
          "compodoc -p tsconfig.compodoc.json -d dist/.compodoc -n \"CV Angular\" --hideGenerator --disablePrivate --disableInternal --disableRoutesGraph --disableCoverage --silent"
        ],
        "parallel": false
      }
    }
  }
}
