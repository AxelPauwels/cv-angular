{
  "name": "cv",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cv/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "defaultConfiguration": "production",
      "options": {},
      "configurations": {
        "production": {
          "target": "cv:esbuild:production"
        },
        "development": {
          "target": "cv:esbuild:development",
          "dev": true
        }
      }
    },
    "material-symbols": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/material-symbols/material-symbols.mjs",
        "{workspaceRoot}/apps/cv/src/**/*",
        "{workspaceRoot}/libs/**/*.html",
        "{workspaceRoot}/libs/**/*.ts"
      ],
      "options": {
        "command": "node tools/material-symbols/material-symbols.mjs",
        "cwd": "{workspaceRoot}"
      },
      "configurations": {
        "write": {
          "command": "node tools/material-symbols/material-symbols.mjs --write"
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "url": "http://localhost:4201"
      },
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "cv:serve-original:development",
        "rebuildDelay": 0,
        "dev": true,
        "port": 0
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "cv:build",
        "port": 4200,
        "staticFilePath": "dist/apps/cv/browser",
        "spa": true
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "cv:esbuild:development",
        "tsConfig": "apps/cv/tsconfig.spec.json",
        "watch": false,
        "browsers": ["ChromiumHeadless"]
      },
      "configurations": {
        "ci": {
          "watch": false,
          "browsers": ["ChromiumHeadless"]
        },
        "watch": {
          "watch": true,
          "browsers": ["Chromium"]
        }
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/cv",
        "browser": "apps/cv/src/main.ts",
        "tsConfig": "apps/cv/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/cv/public"
          },
          {
            "glob": "*.json",
            "input": "libs/shared/ui-lordicon/src/assets",
            "output": "assets/lordicon"
          },
          {
            "glob": "**/*",
            "input": "dist/.playwright/apps/cv-e2e/playwright-report",
            "output": "e2e-report"
          },
          {
            "glob": "**/*",
            "input": "coverage/cv",
            "output": "coverage"
          },
          {
            "glob": "**/*",
            "input": "dist/.graphql-docs/api",
            "output": "graphql-docs"
          },
          {
            "glob": "**/*",
            "input": "dist/.build-info",
            "output": "build-info"
          },
          {
            "glob": "**/*",
            "input": "dist/.project-graph",
            "output": "project-graph"
          }
        ],
        "styles": ["apps/cv/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["apps/cv/src/styles"]
        },
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "node_modules/@tolgee/web/dist/tolgee-web.development.esm.js",
              "with": "node_modules/@tolgee/web/dist/tolgee-web.production.esm.js"
            }
          ]
        },
        "development": {
          "outputPath": "dist/dev/apps/cv",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/cv/src/environments/environment.ts",
              "with": "apps/cv/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4201
      },
      "configurations": {
        "production": {
          "buildTarget": "cv:esbuild:production"
        },
        "development": {
          "buildTarget": "cv:esbuild:development"
        }
      }
    }
  }
}
