{
  "name": "@axel-pauwels/cv",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:cv": "nx serve cv",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --configuration=watch",
    "test:ci": "nx run-many --target=test --all --configuration=ci",
    "test:coverage": "nx run-many --target=test --all --configuration=ci --coverage && open -a \"Google Chrome\" coverage/cv/index.html",
    "e2e": "nx run-many --target=e2e --all; status=$?; open -a \"Google Chrome\" dist/.playwright/apps/cv-e2e/playwright-report/index.html; exit $status",
    "e2e:watch": "nx run-many --target=e2e --all --ui --skip-nx-cache",
    "e2e:report": "npx playwright show-report dist/.playwright/apps/cv-e2e/playwright-report",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "stylelint": "stylelint \"{apps,libs,packages}/**/*.scss\"",
    "stylelint:fix": "stylelint \"{apps,libs,packages}/**/*.scss\" --fix",
    "prettier": "nx format:check",
    "prettier:fix": "nx format:write",
    "nx:show-projects": "nx show projects",
    "nx:graph": "nx graph",
    "codegen": "npx nx run api:codegen && nx run-many --target=codegen --all",
    "postinstall": "patch-package",
    "prepare": "husky",
    "build:production": "sh scripts/build-production.sh",
    "firebase:login": "npx firebase login",
    "firebase:link-project": "npx firebase use --add",
    "firebase:deploy": "npx firebase deploy --only hosting",
    "firebase:deploy-preview": "npx firebase hosting:channel:deploy preview",
    "firebase:emulate": "firebase emulators:start",
    "firebase:link-github": "npx firebase init hosting:github",
    "package:login": "npm login",
    "package:release": "npx nx release --skip-publish",
    "package:publish:mac-window": "npm publish dist/packages/mac-window",
    "package:push-tags": "git push --follow-tags",
    "sheriff:list": "npx sheriff list apps/cv/src/main.ts",
    "sheriff:verify": "npx sheriff verify",
    "detective": "npx detective",
    "i18n:login": "tolgee login",
    "i18n:pull": "tolgee pull",
    "i18n:push": "tolgee push",
    "i18n:check": "node ./scripts/tolgee/check.mjs",
    "i18n:check:unused": "node ./scripts/tolgee/check.mjs --unused",
    "i18n:missing": "node ./scripts/tolgee/missing.mjs",
    "i18n:push-missing": "node ./scripts/tolgee/push-missing.mjs",
    "lighthouse:audit": "npx nx run showcase-feature-lighthouse:audit",
    "build-info": "npx nx run technical-data-access-build-info:build-info"
  },
  "lint-staged": {
    "*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "!(*.{css,scss})": "prettier --write --ignore-unknown"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.0",
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/elements": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/material": "~22.2.5",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@axel-pauwels/mac-window": "^1.0.0",
    "@graphql-tools/merge": "^10.0.8",
    "@graphql-tools/schema": "^11.0.8",
    "@lordicon/element": "^3.0.2",
    "@ngrx/signals": "^22.0.1",
    "@softarc/detective": "^2.1.2",
    "@softarc/native-federation-node": "^2.0.10",
    "@tolgee/ngx": "^7.3.0",
    "es-module-shims": "^1.5.12",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.1",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.4",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@angular/material": "^22.2.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nx/angular": "24.0.2",
    "@nx/devkit": "24.0.2",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/playwright": "24.0.2",
    "@nx/web": "24.0.2",
    "@nx/workspace": "24.0.2",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "~22.2.0",
    "@softarc/eslint-plugin-sheriff": "^0.20.0",
    "@softarc/native-federation-orchestrator": "^4.8.0",
    "@softarc/sheriff-core": "^0.20.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tolgee/cli": "^2.21.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/browser-playwright": "~4.1.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.6.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "firebase-tools": "^15.34.2",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "ng-packagr": "~22.2.0",
    "nx": "24.0.2",
    "patch-package": "^8.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "spectaql": "^3.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "tslib": "^2.3.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.3.2",
    "vitest": "~4.1.0"
  },
  "packageManager": "npm@11.12.1",
  "nx": {
    "includedScripts": []
  }
}
