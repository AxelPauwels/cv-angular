{
  "name": "@axel-pauwels/cv",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:cv": "nx serve cv --port=4444",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch=true",
    "test:ci": "nx run-many --target=test --all --configuration=ci",
    "test:coverage": "nx run-many --target=test --all --configuration=ci --coverage && open -a \"Google Chrome\" coverage/cv/index.html",
    "lint": "nx run-many --target=lint --all",
    "nx:show-projects": "nx show projects",
    "nx:graph": "nx graph",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "rxjs": "~7.8.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.0",
    "@nx/devkit": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/playwright": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/workspace": "24.0.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/browser-playwright": "~4.1.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.6.0",
    "commitlint": "^21.2.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "nx": "24.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "tsx": "^4.20.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "~4.1.0"
  },
  "packageManager": "npm@11.12.1"
}
