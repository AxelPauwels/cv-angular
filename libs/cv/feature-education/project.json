{
  "name": "cv-feature-education",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cv/feature-education/src",
  "prefix": "cv",
  "projectType": "library",
  "tags": ["domain:cv", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/cv/feature-education/ng-package.json",
        "tsConfig": "libs/cv/feature-education/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/cv/feature-education/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"]
      }
    }
  }
}
