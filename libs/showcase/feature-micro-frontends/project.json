{
  "name": "showcase-feature-micro-frontends",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/showcase/feature-micro-frontends/src",
  "prefix": "showcase",
  "projectType": "library",
  "tags": ["domain:showcase", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/showcase/feature-micro-frontends/ng-package.json",
        "tsConfig": "libs/showcase/feature-micro-frontends/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/showcase/feature-micro-frontends/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"]
      }
    }
  }
}
