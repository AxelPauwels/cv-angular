{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/src",
  "projectType": "library",
  "tags": ["domain:shared", "type:api"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/api/ng-package.json",
        "tsConfig": "libs/api/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/api/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/codegen.ts",
        "{projectRoot}/codegen-type-defs-plugin.cjs",
        "{projectRoot}/src/lib/schema/type-defs.graphql"
      ],
      "outputs": [
        "{projectRoot}/src/lib/generated",
        "{projectRoot}/src/lib/internal/generated"
      ],
      "options": {
        "command": "graphql-codegen --config {projectRoot}/codegen.ts"
      }
    },
    "graphql-docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/spectaql.yml",
        "{projectRoot}/src/lib/schema/type-defs.graphql"
      ],
      "outputs": ["{workspaceRoot}/dist/.graphql-docs/api"],
      "options": {
        "command": "spectaql --quiet {projectRoot}/spectaql.yml"
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"]
      }
    }
  }
}
