{
  "name": "technical-feature-versions",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/technical/feature-versions/src",
  "prefix": "technical",
  "projectType": "library",
  "tags": ["domain:technical", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/technical/feature-versions/ng-package.json",
        "tsConfig": "libs/technical/feature-versions/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/technical/feature-versions/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false,
        "browsers": ["ChromiumHeadless"]
      }
    }
  }
}
